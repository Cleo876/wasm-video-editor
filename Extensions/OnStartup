        },

        // --- Lightbox Methods (only button‑triggered, with drag & zoom) ---
        attachLightbox(container) {
            const newsContent = container.querySelector('#news-content');
            if (!newsContent) return;

            newsContent.addEventListener('click', (e) => {
                const btn = e.target.closest('.news-expand-btn');
                if (btn) {
                    e.stopPropagation();
                    const src = btn.dataset.src;
                    if (src) {
                        this.showLightbox(src);
                    }
                }
            });
        },

        showLightbox(src) {
            // If already open, update src and reset transforms
            if (this._lightboxOverlay && this._lightboxOverlay.parentNode) {
                const img = this._lightboxOverlay.querySelector('.lightbox-image-wrapper img');
                if (img) {
                    img.src = src;
                    this._lightboxScale = 1;
                    this._lightboxTranslateX = 0;
                    this._lightboxTranslateY = 0;
                    this.applyLightboxTransform(img);
                }
                return;
            }

            // Create overlay
            const overlay = document.createElement('div');
            overlay.className = 'lightbox-overlay';
            overlay.innerHTML = `
                <div class="lightbox-image-wrapper">
                    <img src="${src}" alt="Expanded view">
                </div>
                <div class="lightbox-close-hint">Click outside to close • Scroll to zoom • Drag to pan</div>
                <div class="lightbox-close-btn" title="Close"><i class="fa-solid fa-xmark"></i></div>
            `;
            document.body.appendChild(overlay);
            this._lightboxOverlay = overlay;
            this._lightboxScale = 1;
            this._lightboxTranslateX = 0;
            this._lightboxTranslateY = 0;

            // Force reflow for transition
            requestAnimationFrame(() => {
                overlay.classList.add('active');
            });

            const imgWrapper = overlay.querySelector('.lightbox-image-wrapper');
            const img = imgWrapper.querySelector('img');

            // Apply initial transform
            this.applyLightboxTransform(img);

            // Close handlers
            const close = () => {
                overlay.classList.remove('active');
                setTimeout(() => {
                    if (overlay.parentNode) overlay.remove();
                    if (this._lightboxOverlay === overlay) this._lightboxOverlay = null;
                }, 300);
                // Clean up drag events
                document.removeEventListener('mousemove', this._boundDragMove);
                document.removeEventListener('mouseup', this._boundDragEnd);
                document.removeEventListener('touchmove', this._boundTouchMove);
                document.removeEventListener('touchend', this._boundTouchEnd);
            };

            // Click on backdrop or close button
            overlay.addEventListener('click', (e) => {
                if (e.target === overlay || e.target.classList.contains('lightbox-close-hint') || e.target.closest('.lightbox-close-btn')) {
                    close();
                }
            });
            overlay.querySelector('.lightbox-close-btn').addEventListener('click', close);

            // --- Zoom with scroll wheel ---
            overlay.addEventListener('wheel', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const delta = e.deltaY > 0 ? -0.1 : 0.1;
                let newScale = this._lightboxScale + delta;
                newScale = Math.min(4, Math.max(0.5, newScale));
                this._lightboxScale = newScale;
                // If scale is 1 (or very close), reset translation to center
                if (newScale <= 1.05) {
                    this._lightboxTranslateX = 0;
                    this._lightboxTranslateY = 0;
                }
                this.applyLightboxTransform(img);
            }, { passive: false });

            // --- Drag to pan (mouse & touch) ---
            let isDragging = false;
            let startX = 0, startY = 0;
            let startTx = 0, startTy = 0;

            const onDragStart = (e) => {
                if (this._lightboxScale <= 1.05) return; // only allow drag when zoomed in
                const ev = e.touches ? e.touches[0] : e;
                isDragging = true;
                startX = ev.clientX;
                startY = ev.clientY;
                startTx = this._lightboxTranslateX;
                startTy = this._lightboxTranslateY;
                imgWrapper.style.cursor = 'grabbing';
                e.preventDefault();
            };

            const onDragMove = (e) => {
                if (!isDragging) return;
                const ev = e.touches ? e.touches[0] : e;
                const dx = ev.clientX - startX;
                const dy = ev.clientY - startY;
                this._lightboxTranslateX = startTx + dx;
                this._lightboxTranslateY = startTy + dy;
                this.applyLightboxTransform(img);
                e.preventDefault();
            };

            const onDragEnd = () => {
                if (isDragging) {
                    isDragging = false;
                    imgWrapper.style.cursor = 'default';
                }
            };

            // Mouse events
            imgWrapper.addEventListener('mousedown', onDragStart);
            document.addEventListener('mousemove', onDragMove);
            document.addEventListener('mouseup', onDragEnd);

            // Touch events
            imgWrapper.addEventListener('touchstart', onDragStart, { passive: false });
            document.addEventListener('touchmove', onDragMove, { passive: false });
            document.addEventListener('touchend', onDragEnd, { passive: false });

            // Store cleanup references for close
            this._boundDragMove = onDragMove;
            this._boundDragEnd = onDragEnd;
            this._boundTouchMove = onDragMove;
            this._boundTouchEnd = onDragEnd;
        },

        applyLightboxTransform(img) {
            if (!img) return;
            const scale = this._lightboxScale;
            const tx = this._lightboxTranslateX;
            const ty = this._lightboxTranslateY;
            img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
        },

        closeLightbox() {
            if (this._lightboxOverlay) {
                this._lightboxOverlay.classList.remove('active');
                setTimeout(() => {
                    if (this._lightboxOverlay && this._lightboxOverlay.parentNode) {
                        this._lightboxOverlay.remove();
                    }
                    this._lightboxOverlay = null;
                }, 300);
            }
        },

        initializeVideoPlayers(container) {
            const players = container.querySelectorAll('.forge-custom-video');
            
            players.forEach(wrapper => {
                const video = wrapper.querySelector('video');
                const playBtn = wrapper.querySelector('.v-play');
                const progressBg = wrapper.querySelector('.v-progress-bg');
                const progressBar = wrapper.querySelector('.v-progress-bar');
                const fullscreenBtn = wrapper.querySelector('.v-fullscreen');
                const timeDisp = wrapper.querySelector('.v-time');

                const formatTime = (time) => {
                    const m = Math.floor(time / 60);
                    const s = Math.floor(time % 60);
                    return `${m}:${s < 10 ? '0' : ''}${s}`;
                };

                const togglePlay = () => {
                    if (video.paused) {
                        video.play();
                        wrapper.classList.remove('paused');
                        playBtn.innerHTML = '<i class="fa-solid fa-pause"></i>';
                    } else {
                        video.pause();
                        wrapper.classList.add('paused');
                        playBtn.innerHTML = '<i class="fa-solid fa-circle-play"></i>';
                    }
                };

                playBtn.onclick = (e) => { e.stopPropagation(); togglePlay(); };
                video.onclick = () => togglePlay();

                video.ontimeupdate = () => {
                    const pct = (video.currentTime / video.duration) * 100;
                    progressBar.style.width = `${pct}%`;
                    timeDisp.innerText = formatTime(video.currentTime);
                };

                video.onended = () => {
                    wrapper.classList.add('paused');
                    playBtn.innerHTML = '<i class="fa-solid fa-rotate-right"></i>';
                };

                progressBg.onclick = (e) => {
                    e.stopPropagation();
                    const rect = progressBg.getBoundingClientRect();
                    const pos = (e.clientX - rect.left) / rect.width;
                    video.currentTime = pos * video.duration;
                };

                fullscreenBtn.onclick = (e) => {
                    e.stopPropagation();
                    if (video.requestFullscreen) video.requestFullscreen();
                    else if (video.webkitRequestFullscreen) video.webkitRequestFullscreen();
                };
            });
        },

        cleanup() {
            this.closeLightbox();
            delete window.ON_STARTUP_WELCOME;
        }
    };

    window.ON_STARTUP_WELCOME = WelcomeModule;
    WelcomeModule.init();

})();
